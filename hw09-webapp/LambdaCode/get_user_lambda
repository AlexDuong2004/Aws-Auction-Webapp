"""First Lambda Function Get User"""
import json
import boto3

s3 = boto3.client('s3')
dynamodb = boto3.resource('dynamodb')
table = dynamodb.Table("HW09-Users")

def get_user_handler(event, context):
    user_id = event.get('userId') 

    try:
        if user_id:
            response = table.get_item(Key={'userId': user_id})

            if 'Item' in response:
                user = response['Item']
                return{
                    'statusCode': 200,
                    'body': json.dumps(user)
                }
            else:
                return{
                    'statusCode': 404,
                    'body': json.dumps({'message': "User not created"})
                }
        else:
            response = table.scan()
            users = response.get('Items', [])
            return {
                'statusCode': 200,
                'body': json.dumps(users)
            }

    except Exception as e:
        print(f"Error: {str(e)}")
        return {
            'statusCode': 500,
            'body': json.dumps({'message': 'An error occurred while fetching users'})
        }

