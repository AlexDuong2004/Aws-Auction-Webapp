"""First Lambda Function Get User"""
import json
import boto3
import decimal

s3 = boto3.client('s3')
dynamodb = boto3.resource('dynamodb')
table = dynamodb.Table("HW09-Users")

def decimal_to_float(item):
    for key, value in item.items():
        if isinstance(value, decimal.Decimal):
            item[key] = float(value)
    return item



def get_user_handler(event, context):
    user_id = event.get('userId') 
    print(user_id)

    try:
        if user_id:
            response = table.get_item(Key={'userId': user_id})

            if 'Item' in response:
                user = response['Item']
                user = decimal_to_float(user)
                print(user)
                return{
                    'statusCode': 200,
                    'body': json.dumps(user)
                }
            else:
                return{
                    'statusCode': 404,
                    'body': json.dumps({'message': "User not created"})
                }
        else:
            response = table.scan()
            users = response.get('Items', [])
            users = [decimal_to_float(user) for user in users]
            print(users)
            return {
                'statusCode': 200,
                'body': json.dumps(users)
            }

    except Exception as e:
        print(f"Error: {str(e)}")
        return {
            'statusCode': 500,
            'body': json.dumps({'message': 'An error occurred while fetching users'})
        }

